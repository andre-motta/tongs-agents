      "listing_after_kill": {
        "-n": [
          "<token>-opt [Created 32s ago] ",
          "<token>-bg [Created 32s ago] ",
          "<token>-main [Created 32s ago] ",
          "<token>-ser [Created 2s ago] (EXITED - attach to resurrect)"
        ],
        "-s": [
          "<token>-main",
          "<token>-opt",
          "<token>-bg",
          "<token>-ser"
        ]
      },
