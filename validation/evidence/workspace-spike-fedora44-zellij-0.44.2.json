{
  "schema": "workspace-spike/1",
  "zellij_version": "zellij 0.44.2",
  "steps": {
    "create": {
      "new_session_with_layout": {
        "argv": [
          "zellij",
          "--session",
          "<session>",
          "--new-session-with-layout",
          "<layout.kdl>"
        ],
        "ready": true,
        "tabs_started": {
          "sidebar": true,
          "main": true,
          "tongs": true
        }
      },
      "new_session_with_layout_existing_name": {
        "exit": 1,
        "stdout": "Session with name \"<token>-main\" already exists. Use attach command to connect to it or specify a different name.",
        "stderr": "",
        "note": "run without a TTY against a session that already exists"
      },
      "layout_then_attach_create_background": {
        "argv": [
          "zellij",
          "--layout",
          "<layout.kdl>",
          "attach",
          "--create-background",
          "<session>"
        ],
        "exit": 0,
        "stderr": "",
        "layout_applied": true,
        "pane_names": [
          "main",
          "sidebar",
          "tongs"
        ]
      },
      "attach_create_background_existing": {
        "exit": 1,
        "stdout": "",
        "stderr": "Session already exists"
      },
      "attach_create_background_options_default_layout": {
        "argv": [
          "zellij",
          "attach",
          "--create-background",
          "<session>",
          "options",
          "--default-layout",
          "<layout.kdl>"
        ],
        "exit": 0,
        "stderr": "",
        "layout_applied": true
      },
      "attach_create_new": {
        "argv": [
          "zellij",
          "attach",
          "--create",
          "<session>"
        ],
        "created": true,
        "terminal_panes": 1,
        "pane_commands": [
          "/bin/sh"
        ]
      },
      "layout_then_attach_create_existing": {
        "argv": [
          "zellij",
          "--layout",
          "<layout.kdl>",
          "attach",
          "--create",
          "<session>"
        ],
        "clients_on_existing": 2,
        "layout_tab_added_or_started": false,
        "new_sessions_created": 0
      },
      "session_layout_adds_tabs": {
        "argv": [
          "zellij",
          "--session",
          "<session>",
          "--layout",
          "<layout.kdl>"
        ],
        "exit": 0,
        "stdout": "1\nterminal_1",
        "stderr": "",
        "layout_started": true,
        "tab_names": [
          "Tab #1",
          "agents",
          "tongs"
        ]
      }
    },
    "spawn": {
      "outside_with_session": {
        "argv": [
          "zellij",
          "--session",
          "<session>",
          "action",
          "new-pane",
          "--name",
          "<name>",
          "--cwd",
          "<dir>",
          "--",
          "<argv>..."
        ],
        "exit": 0,
        "stdout_shape": "terminal_<digits>",
        "stderr": "",
        "zellij_pane_id_env": "3",
        "pane_id_matches_env": true,
        "cwd_applied": true,
        "spike_origin_in_pane": "server-creator",
        "caller_only_variable_in_pane": false,
        "client_focus_before": {
          "1": "terminal_0"
        },
        "client_focus_after": {
          "1": "terminal_3"
        },
        "pane_title": "out-agent"
      },
      "inside_from_sidebar": {
        "argv": [
          "zellij",
          "action",
          "new-pane",
          "--name",
          "<name>",
          "--",
          "<argv>..."
        ],
        "exit": 0,
        "stdout_shape": "terminal_<digits>",
        "stdout_trailing_newline": true,
        "stderr": "",
        "pane_id_matches_env": true,
        "spike_origin_in_pane": "server-creator",
        "caller_only_variable_in_pane": false,
        "client_focus_before": {
          "1": "terminal_3"
        },
        "client_focus_after": {
          "1": "terminal_4"
        }
      },
      "inside_no_focus": {
        "exit": 2,
        "stdout_shape": "",
        "stderr": "error: Found argument '--no-focus' which wasn't expected, or isn't valid in this context\n\n\tIf you tried to supply `--no-focus` as a value rather than a flag, use `-- --no-focus`\n\nUSAGE:\n    zellij action new-pane [OPTIONS] [-- <COMMAND>...]\n\nFor more information try --help\n",
        "pane_started": false,
        "client_focus_before": {
          "1": "terminal_4"
        },
        "client_focus_after": {
          "1": "terminal_4"
        }
      },
      "inside_near_current_pane": {
        "exit": 0,
        "pane_started": true,
        "stderr": "",
        "client_focus_before": {
          "1": "terminal_4"
        },
        "client_focus_after": {
          "1": "terminal_4"
        }
      },
      "unknown_tab_id": {
        "exit": 0,
        "stdout": "terminal_6",
        "stderr": ""
      },
      "unknown_session": {
        "exit": 0,
        "stdout": "\u001b[32;1m<token>-bg\u001b[m [Created \u001b[35;1m8s\u001b[m ago] \n\u001b[32;1m<token>-main\u001b[m [Created \u001b[35;1m8s\u001b[m ago] \n\u001b[32;1m<token>-opt\u001b[",
        "stderr": "Session '<token>-missing' not found. The following sessions are active:"
      }
    },
