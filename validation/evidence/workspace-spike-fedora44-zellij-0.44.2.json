    "exit": {
      "exit3": {
        "action_exit": 0,
        "stdout_shape": "terminal_<digits>",
        "stderr": "",
        "pane_present_after_exit": true,
        "pane_state": {
          "exited": true,
          "exit_status": 3,
          "is_held": true,
          "title": "exit3",
          "terminal_command": "<python> -I <spike_tmp>/bin/agent.py <spike_tmp>/io exit3 3"
        }
      },
      "exit0-close": {
        "action_exit": 0,
        "stdout_shape": "terminal_<digits>",
        "stderr": "",
        "pane_present_after_exit": false,
        "pane_state": null
      },
      "missing": {
        "action_exit": 0,
        "stdout_shape": "terminal_<digits>",
        "stderr": "",
        "pane_present_after_exit": true,
        "pane_state": {
          "exited": true,
          "exit_status": 2,
          "is_held": true,
          "title": "missing",
          "terminal_command": "<spike_tmp>/bin/does-not-exist"
        }
      },
      "missing-close": {
        "action_exit": 0,
        "stdout_shape": "",
        "stderr": "",
        "pane_present_after_exit": false,
        "pane_state": null
      },
